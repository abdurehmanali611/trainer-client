{
  "expo": {
    "name": "FitPilot-Client",
    "slug": "trainer-client",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/fitpilot-icon.png",
    "scheme": "trainerclient",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/fitpilot-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#03070D",
        "foregroundImage": "./assets/images/fitpilot-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.abdurehmanali611.trainerclient"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/fitpilot-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#03070D",
          "image": "./assets/images/fitpilot-splash.png",
          "imageWidth": 240
        }
      ],
      "expo-sharing",
      "expo-audio",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true
          }
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6e785395-3581-464f-85f4-d67227bec9b1"
      }
    }
  }
}
